SERPAPI_KEY=Your SERPAPI_KEY
SILICONFLOW_API_KEY=
MAGICK_API_KEY=
MAGICK_API_URL=https://api.magickapi.com/v1/chat/completions

# 模型名称配置（可选，不设置则使用默认值）
# 本地 Ollama 模型名称
# OLLAMA_MODEL_NAME=deepseek-ai/DeepSeek-R1-Distill-Qwen-7B
# SiliconFlow 云端模型名称
# SILICONFLOW_MODEL_NAME=deepseek-ai/DeepSeek-R1-Distill-Qwen-7B
# Magick API 模型名称
# MAGICK_MODEL_NAME=gpt-4o-mini

# 向量嵌入模型（默认 BAAI/bge-m3，中文 RAG 主流选择，1024 维）
# 轻量回退可选: BAAI/bge-small-zh-v1.5（512 维，约 100MB）
# EMBED_MODEL_NAME=BAAI/bge-m3

# 重排序器模型（默认 BAAI/bge-reranker-v2-m3，与 BGE-M3 官方配套）
# 轻量回退可选: BAAI/bge-reranker-base
# RERANKER_MODEL_NAME=BAAI/bge-reranker-v2-m3
